<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/amplifier/db" VERSION="20250220" COMMENT="XMLDB file for Moodle mod/amplifier"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="amplifier" COMMENT="Reflection training amplifier">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp of when the instance was added to the course."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="learninggoalwidgetid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="-1" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="learninggoalwidgetid" UNIQUE="false" FIELDS="learninggoalwidgetid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="amplifier_goals" COMMENT="Training Amplifier Setup - Gewählte Lernziele">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="amplifierid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lgwgoalid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="amplifierid" TYPE="foreign" FIELDS="amplifierid" REFTABLE="amplifier" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="lgwgoalid" TYPE="foreign" FIELDS="lgwgoalid" REFTABLE="learninggoalwidget_goals" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="amplifier_reminders" COMMENT="Training Amplifier Reminder - Zeitserie Reflection Erinnerung">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="amplifiergoalid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Start timestamp of reminder"/>
        <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="End timestamp of reminder"/>
        <FIELD NAME="reminderhour" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="value between 0 and 23"/>
        <FIELD NAME="reminderminute" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="minute: value between 0 and 59"/>
        <FIELD NAME="frequency" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0=daily 1=weekly 2=monthly"/>
        <FIELD NAME="lastnotificationdate" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp of last notification sent"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="amplifiergoalid" TYPE="foreign" FIELDS="amplifiergoalid" REFTABLE="amplifier_goals" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="startdate" UNIQUE="false" FIELDS="startdate"/>
        <INDEX NAME="enddate" UNIQUE="false" FIELDS="enddate"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="amplifier_reflections" COMMENT="Training Amplifier Reflection - Reflexionen zu gewählten Lernzielen">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="amplifiergoalid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="response" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp of reflection"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="amplifiergoalid" TYPE="foreign" FIELDS="amplifiergoalid" REFTABLE="amplifier_goals" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
