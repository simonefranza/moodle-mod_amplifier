{{!
    @template mod_amplifier/widget/amplifier-reflective-question

    A reflective question

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * amplifier_reflective_question_questiontext
    * amplifier_placeholder_thoughts
    * amplifier_reflective_question_topicid
    * amplifier_reflective_question_goalid

    Example context (json):
    {
        "amplifier_reflective_question_questiontext": "Was haben Sie in der Lehrveranstaltung 'Selbstorganisation, Zeitmanagement und Arbeitstechniken' gelernt? Welche Themenschwerpunkte wurden besprochen?",
        "amplifier_placeholder_thoughts": "Meine Gedanken...",
        "amplifier_reflective_question_topicid": "1",
        "amplifier_reflective_question_goalid": "2",
    }
}}
<fieldset>
    <div class="amplifier-questiontext">
        <p>{{{amplifier_reflective_question_questiontext}}}</p>
    </div>

    <div class="amplifier-user-response">
        <textarea
            placeholder="{{{amplifier_placeholder_thoughts}}}"
            rows="5"
            data-topicid="{{{amplifier_reflective_question_topicid}}}"
            data-goalid="{{{amplifier_reflective_question_goalid}}}"
            class="col p-0 amplifier-user-response-input"></textarea>
    </div>
</fieldset>
